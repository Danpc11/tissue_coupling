# Estilo unico para todas las figuras del articulo.
# Se carga con plt.style.use("python/figures/journal.mplstyle").
# Mantener UN solo fichero de estilo es lo que mas mejora la experiencia del revisor:
# tipografia y grosores identicos en todos los paneles de todas las figuras.

figure.dpi            : 150
savefig.dpi           : 600
savefig.bbox          : tight
savefig.pad_inches    : 0.02
figure.constrained_layout.use : True
figure.constrained_layout.h_pad : 0.045
figure.constrained_layout.w_pad : 0.045
figure.constrained_layout.hspace : 0.06
figure.constrained_layout.wspace : 0.06

font.family           : sans-serif
# Elsevier admite Arial, Helvetica, Times, Courier y Symbol. Liberation Sans es
# metricamente compatible con Arial y se sustituye sin cambiar la maquetacion.
font.sans-serif       : Arial, Liberation Sans, Helvetica, DejaVu Sans
font.size             : 7.5
axes.titlesize        : 7.5   # solo para paneles sin titulo propio; Elsevier pide el titulo en el pie
axes.labelsize        : 7.0
xtick.labelsize       : 7.0
ytick.labelsize       : 7.0
legend.fontsize       : 6.5
legend.title_fontsize : 6.0

axes.linewidth        : 0.7
axes.spines.top       : False
axes.spines.right     : False
axes.titlepad         : 5.0
axes.labelpad         : 2.5
xtick.major.width     : 0.7
ytick.major.width     : 0.7
xtick.major.size      : 2.5
ytick.major.size      : 2.5
lines.linewidth       : 1.1
lines.markersize      : 4.0
patch.linewidth       : 0.4

# Okabe-Ito: paleta cualitativa segura para daltonismo (Nature Methods 2011)
axes.prop_cycle : cycler('color', ['0072B2','D55E00','009E73','CC79A7','E69F00','56B4E9','F0E442','000000'])

pdf.fonttype          : 42
ps.fonttype           : 42
svg.fonttype          : none
image.cmap            : cividis
